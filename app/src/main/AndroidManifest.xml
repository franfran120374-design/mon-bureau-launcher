<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Geolocalisation : indispensable pour que la tuile velo trouve les
      stations autour de toi. Sans ces deux lignes, le WebView ne peut
      meme pas demander la position.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications affichees par Mon Bureau lui-meme (Android 13 et plus) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Visibilite des paquets (obligatoire depuis Android 11) :
      permet de lister les applications installees et de resoudre
      les applications par defaut utilisees par le dock.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Mon Bureau"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">

            <!-- Icone normale dans le tiroir d'applications -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Rend l'appli selectionnable comme ecran d'accueil -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <activity
            android:name=".AppDrawerActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!--
          Lecture des notifications des autres applications.

          android:permission est impose par Android : seul le systeme a le
          droit de demarrer ce service. exported="true" ne veut donc pas dire
          "ouvert a tous", mais "visible du systeme", ce qui est obligatoire.

          Le service reste inerte tant que tu ne l'as pas autorise a la main
          dans Parametres > Acces speciaux > Acces aux notifications.
        -->
        <service
            android:name=".VeloNotificationService"
            android:label="Mon Bureau - trajets velo"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
