<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1c1c1e">

    <!-- Bandeau d'erreur : masque par defaut, apparait seulement en cas de probleme -->
    <TextView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:textColor="#FFD60A"
        android:textSize="12sp"
        android:padding="10dp"
        android:visibility="gone" />

    <!-- Mon Bureau occupe tout l'espace restant, sans etre masque par le dock -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Dock : raccourcis rapides vers les apps essentielles du telephone -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F0000000"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center" />

</LinearLayout>
